# copy to .env (git-ignored) and run:  python -m uvicorn api:app --env-file .env
D3_DSN=postgresql://d3:d3@localhost:5432/d3
D3_JWT_SECRET=change-me-to-a-long-random-string
D3_FRONTEND_URL=http://localhost:5173/prj1/
# comma-separated origins allowed to call the API from a browser (the Pages site, no trailing slash)
D3_CORS_ORIGINS=https://ursweetheart.github.io
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GEMINI_API_KEY=
